# Telegram API credentials from https://my.telegram.org/auth?to=apps
API_ID=12345678
API_HASH=your_api_hash_here
PHONE_NUMBER=+1234567890

# Telegram Chat ID to monitor and download files from
# Supergroups and Channels typically start with -100 (e.g. -1001234567890)
CHAT_ID=-1001234567890

# Admin Bot configuration
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_USER_IDS=123456789,987654321

# Downloader & Auto download settings
AUTO_DOWNLOAD=false
BOT_PROGRESS_UPDATE_INTERVAL=2

# Directory paths
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
LOG_DIR=./logs

# Queue configuration
MAX_CONCURRENT_DOWNLOADS=1

# Speed optimization: Number of parallel MTProto connections per file (Recommended: 4 to 8)
PARALLEL_CONNECTIONS=4

# Minimum required disk space in GB before starting a download
MIN_DISK_SPACE_GB=5.0

